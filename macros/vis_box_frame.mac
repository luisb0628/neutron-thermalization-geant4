# vis_box_frame.mac — exporta un único frame de la geometría sólida (sin eventos)
# Genera box_frame_0000.eps para usar como overlay de referencia
/control/macroPath ../macros
/control/verbose 0
/run/verbose 0
/event/verbose 0
/tracking/verbose 0

# Misma geometría que vis_video.mac
/detector/setParaffinX 6 cm
/detector/setParaffinY 6 cm
/detector/setParaffinZ 4 cm
/detector/setLeadZ 2 cm
/ambe/distance 0 cm
/ambe/activity 2.98

/run/initialize

# Mismo driver, resolución y ángulo que vis_video.mac
/vis/open OGLSX 2000x2000
/vis/viewer/set/viewpointThetaPhi 30 20
/vis/viewer/set/background 0 0 0 1

# Mismos colores que vis_video.mac
/vis/geometry/set/colour Block    0 226 212 183 .3
/vis/geometry/set/colour Detector 0 28 28 28 1
/vis/geometry/set/colour Lead     0 0 212 200 .3
/vis/viewer/set/style surface
/vis/geometry/set/forceSolid Detector 0
/vis/scene/create
/vis/scene/add/volume
/vis/drawVolume
/vis/enable
/vis/viewer/refresh
/vis/ogl/set/exportFormat eps
/vis/ogl/export box_frame.eps

# ambe_run.mac — Simulación de termalización con fuente AmBe
/control/verbose 0
/run/verbose 1
/event/verbose 0
/tracking/verbose 0

# ----------------------------------------------------------------
# Geometría de la parafina (half-lengths)
# ----------------------------------------------------------------
/detector/setParaffinX 7 cm
/detector/setParaffinY 7 cm
/detector/setParaffinZ 4.5 cm

# ----------------------------------------------------------------
# Bloque de plomo (half-length en Z = espesor/2)
#   Area fija: 20x20 cm
#   Espesor inicial: 3 cm → setLeadZ = 1.5 cm
# ----------------------------------------------------------------
/detector/setLeadZ 8 cm

# ----------------------------------------------------------------
# Fuente AmBe
#   distance : distancia fuente → cara frontal del PLOMO
#   activity : en Ci (solo para normalización en el reporte)
# ----------------------------------------------------------------
/ambe/distance 0 cm
/ambe/activity 0.03
# ----------------------------------------------------------------
# Inicialización
# ----------------------------------------------------------------
/run/initialize

# ----------------------------------------------------------------
# Simulación
#   Cada evento = 1 neutrón AmBe (+ gamma 4.44 MeV con P=60%)
#   Ajusta beamOn según estadística deseada
# ----------------------------------------------------------------
/run/beamOn 10000000

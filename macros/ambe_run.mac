# ambe_run.mac — Simulación de termalización con AmBe + Cs-137 juntas (legacy)
#
# OBSOLETO para análisis: ahora se recomienda correr ambe_only.mac y
# cs137_only.mac por separado (el Cs-137 produce muchos más fotones por
# evento que la cadena de neutrones del AmBe, así que mezclarlas 1 evento =
# 1 neutrón + 1 gamma no da la estadística real de cada fuente) y combinar
# los dos .root resultantes en el análisis. Este macro se deja solo como
# referencia del modo "Both" (/source/mode Both, el default).
/control/verbose 0
/run/verbose 1
/event/verbose 0
/tracking/verbose 0

# ----------------------------------------------------------------
# Geometría de la parafina (half-lengths)
# ----------------------------------------------------------------
/detector/setParaffinX 6 cm
/detector/setParaffinY 6 cm
/detector/setParaffinZ 4 cm

# ----------------------------------------------------------------
# Bloque de plomo (half-length en Z = espesor/2)
#   Area fija: 20x20 cm
#   Espesor inicial: 3 cm → setLeadZ = 1.5 cm
# ----------------------------------------------------------------
/detector/setLeadZ 5 cm

# ----------------------------------------------------------------
# Fuente AmBe
#   distance : distancia fuente → cara frontal del PLOMO
#   activity : en Ci (solo para normalización en el reporte)
# ----------------------------------------------------------------
/ambe/distance 0 cm
/ambe/activity 0.03

/source/mode Both
# ----------------------------------------------------------------
# Inicialización
# ----------------------------------------------------------------
# Numero de hilos: por defecto se usan todos los nucleos del equipo.
# Descomentar para fijarlo; debe ir antes de /run/initialize.
#/run/numberOfThreads 4

/run/initialize

# ----------------------------------------------------------------
# Simulación
#   Cada evento = 1 neutrón AmBe (+ gamma 4.44 MeV con P=60%)
#   Ajusta beamOn según estadística deseada
# ----------------------------------------------------------------
/run/beamOn 1000000
